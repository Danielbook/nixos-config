{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Stockholm",
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.yaml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/^k8s/infra/.+\\.yaml$/"]
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "A database major needs a manual migration: pg_upgrade or a dump and restore for Postgres, one major at a time for MongoDB. Do it by hand.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "ghcr.io/immich-app/postgres", "mongo"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Mark major updates, so that they are easy to find in the PR list.",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"]
    }
  ]
}
